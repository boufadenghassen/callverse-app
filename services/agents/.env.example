# Copy this file to services/agents/.env and fill it in. The real .env is ignored by git: never commit a key.
# The Training Coach uses this model for plan guidance and scenario wording. Deterministic templates remain the fallback.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_TIMEOUT=25
# SCENARIO_STORE_PATH=data/scenarios.jsonl
# CUSTOMER_SIM_INTENTS_PATH=

# The local language model (Ollama) that writes the advisor agent's replies and the scenario wording. Everything works without it.
# LOCAL_LLM=0
# LOCAL_LLM_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434
# LOCAL_LLM_TIMEOUT=20
