# Modèle de texte local (Ollama)
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b

# Langues tirées au hasard (derja désactivé pour l'instant)
ENABLED_LANGUAGES=fr,en

# Voix du client : local = Piper hors-ligne (python download_voices.py une fois)
TTS_BACKEND=local
# TTS_THREADS=4            # coeurs utilisés par la synthèse vocale

# Transcription de ta voix : vide = auto (base.en pour l'anglais, base pour le français).
# Plus précis mais plus lent : small
# STT_MODEL=small
VAD_SILENCE=0.8          # secondes de silence qui terminent ta phrase
LLM_MAX_TOKENS=120       # longueur max d'une réplique du client
